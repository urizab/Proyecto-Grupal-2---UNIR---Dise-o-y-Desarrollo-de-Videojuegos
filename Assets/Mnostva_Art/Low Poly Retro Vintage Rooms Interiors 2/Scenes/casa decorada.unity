  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\xA1Corre, creo que la puerta de atr\xE1s est\xE1 abierta! \n\nSalta sobre
    mi cabeza usando [ESPACIO] y cruza esta zanja para llegar al otro lado del jard\xEDn.\n\nRecuerda
    que puedes hacer salto doble, pero ten en cuenta que eso consumir\xE1 un poco
    de agua de la reserva de tu tanque.\n\nLa familia Smith puso esta valla para
    evitar que el gato se escapase. \n\xA1Pero qu\xE9 ingenuos!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 78cdd663b6446e54c8967361df0c61fb, type: 2}
  m_sharedMaterial: {fileID: 4967201970850754531, guid: 78cdd663b6446e54c8967361df0c61fb, type: 2}
