  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ehh t\xFA, roedor: Hay fuegos normales\u2026 y luego est\xE1n LOS MALOS,
    caracter\xEDsticos por su color rojo. Esos incendios consumen tanta agua que
    tu mochila se vac\xEDa m\xE1s r\xE1pido que el cerebro de un pato golpe\xE1ndose
    contra una ventana.\r\n\r\n\xBFLa soluci\xF3n?\r\n\r\nPonte cerca de una toma
    de agua mientras disparas la manguera. As\xED el dep\xF3sito se rellena al mismo
    tiempo y podr\xE1s apagar esas llamas monstruosas.\r\n\r\nO no lo hagas. Total,
    la casa solo explotar\xEDa un poco."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 78cdd663b6446e54c8967361df0c61fb, type: 2}
  m_sharedMaterial: {fileID: 4967201970850754531, guid: 78cdd663b6446e54c8967361df0c61fb, type: 2}
