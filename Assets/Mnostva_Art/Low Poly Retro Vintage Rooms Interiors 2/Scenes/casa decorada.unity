    - target: {fileID: 2437505959028832029, guid: 584e4631e50834d409940e7a75eff875, type: 3}
      propertyPath: m_text
      value: "Esc\xFAchame, Mickey Mouse:\r\n\r\nLa puerta est\xE1 cerrada pero estoy
        seguro de que puedes hacer algo con el cubo que cuelga del picaporte.\nSi
        fuese t\xFA, probar\xEDa a llenarlo desde arriba.\n \r\n\xA1Ah! Y si te quedas
        sin agua recuerda que puedes recargar el tanque acerc\xE1ndote a una toma
        de agua y pulsando [E]."
      objectReference: {fileID: 0}
